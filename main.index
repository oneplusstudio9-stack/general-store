    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="data:," />
    <title>NandN International — General Store &amp; Inventory Dashboard</title>
    <meta name="description" content="NandN International general store: browse all 293 everyday products with pictures and Rs prices, filter and sort the live inventory, and add items to your buy list." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <script src="data:application/javascript;base64,"></script>
    <script>
      tailwind.config = {
        darkMode: 'class',
        theme: {
          extend: {
            fontFamily: {
              display: ['"Bricolage Grotesque"', 'sans-serif'],
              body: ['Manrope', 'sans-serif']
            },
            colors: {
              brand: {50:'#f0f9f1',100:'#dcf0de',200:'#bbe0c0',300:'#8ec796',400:'#5ca568',500:'#388047',600:'#276636',700:'#20532c',800:'#1b4325',900:'#15351d',950:'#0a1f10'},
              accent: {400:'#fbbf24',500:'#f59e0b',600:'#d97706'}
            }
          }
        }
      };
    </script>
    <style>
      html { scroll-behavior: smooth; }
      body { font-family: 'Manrope', sans-serif; }
      section { scroll-margin-top: 84px; }
      button, [role="button"], select, summary, input:not([type="checkbox"], [type="radio"]) { min-height: 2.25rem; }
      ::selection { background: #276636; color: #fff; }
      .no-scrollbar::-webkit-scrollbar { display: none; }
      .no-scrollbar { scrollbar-width: none; }
      /* Inventory table: stack rows into cards on small phones — no sideways scroll */
      @media (max-width: 767px) {
        .inv-table thead { display: none; }
        .inv-table, .inv-table tbody, .inv-table tr, .inv-table td { display: block; width: 100%; }
        .inv-table tr { border: 1px solid rgba(120,130,120,.25); border-radius: 14px; margin-bottom: 12px; padding: 10px 12px; }
        .inv-table td { border: 0 !important; padding: 4px 0 !important; text-align: left !important; }
        .inv-table td::before { content: attr(data-label); display: block; font-size: 10px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; opacity: .55; margin-bottom: 1px; }
        .inv-table td.cell-img::before, .inv-table td.cell-buy::before { display: none; }
      }
      th.drag-over { box-shadow: inset 3px 0 0 #f59e0b; }
      input[type="range"] { accent-color: #276636; }
      .drawer { transition: transform .32s cubic-bezier(.32,.72,.24,1); }
      .fadein { animation: fadeUp .45s ease both; }
      @keyframes fadeUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
      .toast { animation: toastIn .25s ease both; }
      @keyframes toastIn { from { opacity: 0; transform: translateY(8px) scale(.97); } to { opacity: 1; transform: none; } }
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after { animation-duration: .001s !important; transition-duration: .001s !important; }
      }
    </style>
  </head>
