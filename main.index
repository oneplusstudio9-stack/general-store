ldren; mix with water as per pack directions. Keep the tin sealed and dry.", "img": "data:image/jpeg;base64,"}, {"id": 287, "name": "Nestle Milk Powder Nangrow 3 Optipro 600 g", "brand": "Nestlé", "cat": "Baby Care", "pack": "600 g", "price": 2445, "det": "Growing-up milk powder for children; mix with water as per pack directions. Keep the tin sealed and dry.", "img": "data:image/jpeg;base64,"}, {"id": 288, "name": "Huggies Baby Wipes 56 pcs Natural Care With Aloe Vera", "brand": "Huggies", "cat": "Baby Care", "pack": "56 pcs", "price": 495, "det": "Gentle baby wipes for diaper changes and hands; keep the lid closed so wipes stay moist.", "img": "data:image/jpeg;base64,"}, {"id": 289, "name": "Pampers Baby Wipes Fresh Clean 52 pcs", "brand": "Pampers", "cat": "Baby Care", "pack": "52 pcs", "price": 645, "det": "Gentle baby wipes for diaper changes and hands; keep the lid closed so wipes stay moist.", "img": "data:image/jpeg;base64,"}, {"id": 290, "name": "Johnson's Baby Soap Milk 75 g", "brand": "Johnson's", "cat": "Baby Care", "pack": "75 g", "price": 245, "det": "Mild baby toiletry for daily bathing; use a small amount and keep out of the eyes.", "img": "data:image/jpeg;base64,"}, {"id": 291, "name": "Johnson's Baby Shampoo 100 ml", "brand": "Johnson's", "cat": "Baby Care", "pack": "100 ml", "price": 295, "det": "Mild baby toiletry for daily bathing; use a small amount and keep out of the eyes.", "img": "data:image/jpeg;base64,"}, {"id": 292, "name": "Mothercare Baby Powder Medium 215 g", "brand": "Mothercare", "cat": "Baby Care", "pack": "215 g", "price": 395, "det": "Mild baby toiletry for daily bathing; use a small amount and keep out of the eyes.", "img": "data:image/jpeg;base64,"}, {"id": 293, "name": "Hop & Roll Baby Wipes 85 pcs", "brand": "Hop & Roll", "cat": "Baby Care", "pack": "85 pcs", "price": 185, "det": "Gentle baby wipes for diaper changes and hands; keep the lid closed so wipes stay moist.", "img": "data:image/jpeg;base64,"}];
      const ALL_CATS = [...new Set(PRODUCTS.map(p => p.cat))];
      const ALL_BRANDS = [...new Set(PRODUCTS.map(p => p.brand))].sort((a, b) => a.localeCompare(b));
      const MAX_PRICE = Math.max(...PRODUCTS.map(p => p.price));
      const MIN_PRICE = Math.min(...PRODUCTS.map(p => p.price));
      const fmt = n => 'Rs ' + n.toLocaleString('en-US');

      const PATHS = {
        cart: 'M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z',
        sun: 'M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z',
        moon: 'M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z',
        search: 'm21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z',
        grid: 'M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z',
        table: 'M3.375 19.5h17.25m-17.25 0a1.125 1.125 0 0 1-1.125-1.125M3.375 19.5h1.5C5.496 19.5 6 18.996 6 18.375m-3.75 0V5.625m0 12.75v-1.5c0-.621.504-1.125 1.125-1.125m18.375 2.625V5.625m0 12.75c0 .621-.504 1.125-1.125 1.125m1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125m0 3.75h-1.5A1.125 1.125 0 0 1 18 18.375M20.625 4.5H3.375m17.25 0c.621 0 1.125.504 1.125 1.125M20.625 4.5h-1.5C18.504 4.5 18 5.004 18 5.625m3.75 0v1.5c0 .621-.504 1.125-1.125 1.125M3.375 4.5c-.621 0-1.125.504-1.125 1.125M3.375 4.5h1.5C5.496 4.5 6 5.004 6 5.625m-3.75 0v1.5c0 .621.504 1.125 1.125 1.125m0 0h1.5m-1.5 0c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125m1.5-3.75c.621 0 1.125.504 1.125 1.125v1.5c0 .621-.504 1.125-1.125 1.125m-2.25 0c.621 0 1.125.504 1.125 1.125v1.5c0 .621-.504 1.125-1.125 1.125M18 5.625v1.5c0 .621.504 1.125 1.125 1.125M18 5.625c0-.621.504-1.125 1.125-1.125m0 0h1.5m-1.5 0c.621 0 1.125.504 1.125 1.125v1.5c0 .621-.504 1.125-1.125 1.125M6 10.875v-1.5c0-.621.504-1.125 1.125-1.125m-1.5 0c.621 0 1.125.504 1.125 1.125v1.5c0 .621-.504 1.125-1.125 1.125M6 10.875c0-.621-.504-1.125-1.125-1.125M18 10.875c.621 0 1.125.504 1.125 1.125v1.5c0 .621-.504 1.125-1.125 1.125m-1.5 0v-1.5c0-.621.504-1.125 1.125-1.125M6 18.375v-1.5c0-.621.504-1.125 1.125-1.125m-1.5 0c.621 0 1.125.504 1.125 1.125v1.5c0 .621-.504 1.125-1.125 1.125M18 18.375v-1.5c0-.621.504-1.125 1.125 1.125m-1.5 0c.621 0 1.125.504 1.125 1.125v1.5c0 .621-.504 1.125-1.125 1.125',
        plus: 'M12 4.5v15m7.5-7.5h-15',
        minus: 'M5 12h14',
        x: 'M6 18 18 6M6 6l12 12',
        check: 'm4.5 12.75 6 6 9-13.5',
        trash: 'm14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0',
        menu: 'M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5',
        chart: 'M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z',
        download: 'M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3',
        grip: 'M8.25 6.75h.008v.008H8.25V6.75Zm7.5 0h.008v.008h-.008V6.75Zm-7.5 7.5h.008v.008H8.25v-.008Zm7.5 0h.008v.008h-.008v-.008Zm-7.5 7.5h.008v.008H8.25v-.008Zm7.5 0h.008v.008h-.008v-.008Z'
      };
      const Icon = ({ d, cls }) => html`<svg className=${cls || 'w-5 h-5'} fill="none" viewBox="0 0 24 24" strokeWidth="1.8" stroke="currentColor" aria-hidden="true"><path strokeLinecap="round" strokeLinejoin="round" d=${d} /></svg>`;

      const COLUMNS = [
        { key: 'img', label: 'Picture', sortable: false },
        { key: 'id', label: 'No.', sortable: true },
        { key: 'name', label: 'Product', sortable: true },
        { key: 'brand', label: 'Brand', sortable: true },
        { key: 'cat', label: 'Category', sortable: true },
        { key: 'pack', label: 'Pack Size', sortable: false },
        { key: 'price', label: 'Price', sortable: true },
        { key: 'det', label: 'Details', sortable: false },
        { key: 'buy', label: 'Buy', sortable: false }
      ];

      function App() {
        const [dark, setDark] = useState(() => window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
        const [menuOpen, setMenuOpen] = useState(false);
        const [query, setQuery] = useState('');
        const [cat, setCat] = useState('');
        const [brand, setBrand] = useState('');
        const [sort, setSort] = useState('featured');
        const [maxPrice, setMaxPrice] = useState(MAX_PRICE);
        const [view, setView] = useState('grid');
        const [limit, setLimit] = useState(48);
        const [cols, setCols] = useState(COLUMNS.map(c => c.key));
        const [dragIdx, setDragIdx] = useState(null);
        const [overIdx, setOverIdx] = useState(null);
        const [cart, setCart] = useState({});
        const [cartOpen, setCartOpen] = useState(false);
        const [toast, setToast] = useState(null);
        const [placed, setPlaced] = useState(false);
        const [showInsights, setShowInsights] = useState(false);
        const toastTimer = useRef(null);

        useEffect(() => { document.documentElement.classList.toggle('dark', dark); }, [dark]);
        useEffect(() => { setLimit(48); }, [query, cat, brand, sort, maxPrice, view]);

        const say = msg => {
          setToast(msg);
          clearTimeout(toastTimer.current);
          toastTimer.current = setTimeout(() => setToast(null), 2400);
        };

        const filtered = useMemo(() => {
          const q = query.trim().toLowerCase();
          let list = PRODUCTS.filter(p =>
            (!q || (p.name + ' ' + p.brand + ' ' + p.cat + ' ' + p.pack + ' ' + p.det).toLowerCase().includes(q)) &&
            (!cat || p.cat === cat) &&
            (!brand || p.brand === brand) &&
            p.price <= maxPrice
          );
          const by = {
            'price-asc': (a, b) => a.price - b.price,
            'price-desc': (a, b) => b.price - a.price,
            'name-asc': (a, b) => a.name.localeCompare(b.name),
            'name-desc': (a, b) => b.name.localeCompare(a.name),
            'brand-asc': (a, b) => a.brand.localeCompare(b.brand),
            'cat-asc': (a, b) => a.cat.localeCompare(b.cat) || a.name.localeCompare(b.name)
          }[sort];
          if (by) list = [...list].sort(by);
          return list;
        }, [query, cat, brand, sort, maxPrice]);

        const visible = filtered.slice(0, limit);
        const cartIds = Object.keys(cart).map(Number);
        const cartCount = cartIds.reduce((s, id) => s + cart[id], 0);
        const cartTotal = cartIds.reduce((s, id) => s + cart[id] * PRODUCTS[id - 1].price, 0);

        const catAvgs = useMemo(() => ALL_CATS.map(c => {
          const items = PRODUCTS.filter(p => p.cat === c);
          return { cat: c, n: items.length, avg: Math.round(items.reduce((s, p) => s + p.price, 0) / items.length) };
        }).sort((a, b) => b.avg - a.avg), []);
        const maxAvg = catAvgs[0].avg;

        const setQty = (id, q) => setCart(prev => {
          const next = { ...prev };
          if (q <= 0) delete next[id]; else next[id] = q;
          return next;
        });
        const addToCart = p => { setQty(p.id, (cart[p.id] || 0) + 1); say('Added: ' + p.name); };

        const moveCol = (i, dir) => {
          const j = i + dir;
          if (j < 0 || j >= cols.length) return;
          const next = [...cols]; [next[i], next[j]] = [next[j], next[i]]; setCols(next);
        };
        const dropCol = i => {
          if (dragIdx === null || dragIdx === i) { setDragIdx(null); setOverIdx(null); return; }
          const next = [...cols]; const [moved] = next.splice(dragIdx, 1); next.splice(i, 0, moved);
          setCols(next); setDragIdx(null); setOverIdx(null);
        };
        const headerSort = key => {
          const map = { name: ['name-asc', 'name-desc'], price: ['price-asc', 'price-desc'], brand: ['brand-asc', 'brand-asc'], cat: ['cat-asc', 'cat-asc'], id: ['featured', 'featured'] };
          const pair = map[key]; if (!pair) return;
          setSort(sort === pair[0] ? pair[1] : pair[0]);
          setView('table');
        };

        const shopCategory = c => {
          setCat(c); setBrand(''); setQuery('');
          document.getElementById('products').scrollIntoView({ behavior: 'smooth' });
        };

        const downloadOrder = () => {
          const lines = ['NandN International — Order List', 'Date: ' + new Date().toLocaleString(), '----------------------------------------'];
          cartIds.forEach(id => { const p = PRODUCTS[id - 1]; lines.push(cart[id] + ' x ' + p.name + ' (' + p.pack + ') — ' + fmt(p.price * cart[id])); });
          lines.push('----------------------------------------', 'Total: ' + fmt(cartTotal), '', 'Show this list at the counter or share it with the store to complete your purchase.');
          const a = document.createElement('a');
          a.href = URL.createObjectURL(new Blob([lines.join('\n')], { type: 'text/plain' }));
          a.download = 'nandn-order.txt'; a.click(); URL.revokeObjectURL(a.href);
          setPlaced(true);
        };

        const cellFor = (p, key) => {
          const col = COLUMNS.find(c => c.key === key);
          if (key === 'img') return html`<td key="img" data-label="" className="cell-img px-3 py-2"><img src=${p.img} alt=${p.name} className="w-14 h-14 md:w-16 md:h-16 object-contain rounded-lg bg-white border border-zinc-200 dark:border-zinc-700" /></td>`;
          if (key === 'buy') return html`<td key="buy" data-label="" className="cell-buy px-3 py-2">${cart[p.id]
            ? html`<span className="inline-flex items-center gap-1 bg-brand-50 dark:bg-brand-950 border border-brand-200 dark:border-brand-800 rounded-full p-1">
                <button onClick=${() => setQty(p.id, cart[p.id] - 1)} aria-label="Remove one" className="w-8 h-8 grid place-items-center rounded-full hover:bg-white dark:hover:bg-brand-900"><${Icon} d=${PATHS.minus} cls="w-4 h-4" /></button>
                <b className="w-6 text-center text-sm">${cart[p.id]}</b>
                <button onClick=${() => setQty(p.id, cart[p.id] + 1)} aria-label="Add one" className="w-8 h-8 grid place-items-center rounded-full hover:bg-white dark:hover:bg-brand-900"><${Icon} d=${PATHS.plus} cls="w-4 h-4" /></button>
              </span>`
            : html`<button onClick=${() => addToCart(p)} className="whitespace-nowrap bg-brand-600 hover:bg-brand-700 text-white text-sm font-bold px-4 py-2 rounded-full">Add to Buy</button>`}</td>`;
          const val = key === 'price' ? fmt(p.price) : key === 'id' ? p.id : p[key];
          return html`<td key=${key} data-label=${col.label} className=${'px-3 py-2 text-sm align-middle ' + (key === 'price' ? 'font-extrabold text-brand-700 dark:text-brand-300 whitespace-nowrap' : '') + (key === 'name' ? 'font-bold min-w-[180px]' : '') + (key === 'det' ? 'text-zinc-500 dark:text-zinc-400 min-w-[220px]' : '')}>${val}</td>`;
        };

        const heroImgs = [13, 37, 49, 90, 126, 186].map(id => PRODUCTS[id - 1]);

        return html`
        <div className="min-h-screen flex flex-col">
          <!-- ===== Header ===== -->
          <header className="sticky top-0 z-40 bg-white/90 dark:bg-[#10160f]/90 backdrop-blur border-b border-zinc-200 dark:border-zinc-800">
            <div className="max-w-7xl mx-auto px-4 sm:px-6 h-[68px] flex items-center gap-3">
              <a href="#home" className="flex items-center gap-3 shrink-0">
                <span className="h-11 min-w-[52px] px-1.5 rounded-2xl bg-brand-700 text-white grid place-items-center font-display font-extrabold text-[13px] tracking-tight shadow-md shadow-brand-600/20">N&N</span>
                <span className="leading-tight min-w-0">
                  <span className="block font-display font-bold text-[15px] sm:text-lg whitespace-nowrap">NandN International</span>
                  <span className="hidden min-[420px]:block text-[11px] font-semibold tracking-[.14em] uppercase text-brand-600 dark:text-brand-400">General Store · Pakistan</span>
                </span>
              </a>
              <nav className="hidden md:flex items-center gap-1 ml-8 text-sm font-bold">
                ${[['#home', 'Home'], ['#about', 'About'], ['#products', 'Products'], ['#contact', 'Contact']].map(([href, label]) => html`<a key=${href} href=${href} className="px-4 py-2 rounded-full hover:bg-brand-50 dark:hover:bg-brand-950 hover:text-brand-700 dark:hover:text-brand-300">${label}</a>`)}
              </nav>
              <div className="ml-auto flex items-center gap-2">
                <button onClick=${() => setDark(!dark)} aria-label="Toggle dark mode" className="w-11 h-11 grid place-items-center rounded-full border border-zinc-200 dark:border-zinc-700 hover:bg-zinc-100 dark:hover:bg-zinc-800">
                  <${Icon} d=${dark ? PATHS.sun : PATHS.moon} cls="w-5 h-5" />
                </button>
                <button onClick=${() => { setCartOpen(true); setPlaced(false); }} aria-label="Open buy list" className="relative h-11 px-3.5 sm:pl-4 sm:pr-5 inline-flex items-center gap-2 rounded-full bg-brand-600 hover:bg-brand-700 text-white font-bold text-sm">
                  <${Icon} d=${PATHS.cart} cls="w-5 h-5" /> <span className="hidden sm:inline">Buy List</span>
                  ${cartCount > 0 && html`<span className="absolute -top-1.5 -right-1.5 min-w-[22px] h-[22px] px-1 grid place-items-center rounded-full bg-accent-500 text-white text-[11px] font-extrabold border-2 border-white dark:border-[#10160f]">${cartCount}</span>`}
                </button>
                <button onClick=${() => setMenuOpen(!menuOpen)} aria-label="Menu" className="md:hidden w-11 h-11 grid place-items-center rounded-full border border-zinc-200 dark:border-zinc-700"><${Icon} d=${PATHS.menu} cls="w-5 h-5" /></button>
              </div>
            </div>
            ${menuOpen && html`<nav className="md:hidden border-t border-zinc-200 dark:border-zinc-800 px-4 py-3 grid grid-cols-4 gap-2 text-center text-sm font-bold">
              ${[['#home', 'Home'], ['#about', 'About'], ['#products', 'Products'], ['#contact', 'Contact']].map(([href, label]) => html`<a key=${href} href=${href} onClick=${() => setMenuOpen(false)} className="py-2.5 rounded-xl bg-zinc-100 dark:bg-zinc-800">${label}</a>`)}
            </nav>`}
          </header>

          <!-- ===== HOME / Hero ===== -->
          <section id="home" className="relative overflow-hidden">
            <div className="absolute inset-0 bg-gradient-to-br from-brand-50 via-transparent to-accent-400/10 dark:from-brand-950 dark:to-transparent pointer-events-none"></div>
            <div className="relative max-w-7xl mx-auto px-4 sm:px-6 pt-10 pb-14 lg:pt-16 lg:pb-20 grid lg:grid-cols-2 gap-10 items-center">
              <div className="fadein">
                <span className="inline-flex items-center gap-2 text-[11px] font-extrabold tracking-[.16em] uppercase bg-white dark:bg-zinc-900 border border-brand-200 dark:border-brand-800 text-brand-700 dark:text-brand-300 px-3 py-1.5 rounded-full">293 products · 24 departments · Prices in Rs</span>
                <h1 className="font-display font-extrabold text-[40px] leading-[1.02] sm:text-6xl mt-5">Everything your home needs, <span className="text-brand-600 dark:text-brand-400">on one shelf.</span></h1>
                <p className="mt-5 text-base sm:text-lg text-zinc-600 dark:text-zinc-300 max-w-xl">From atta, rice and cooking oil to baby care and batteries — browse the complete NandN International catalogue with pictures and printed prices, filter the live inventory, and build your buy list in seconds.</p>
                <div className="mt-7 flex flex-wrap gap-3">
                  <a href="#products" className="h-12 px-6 inline-flex items-center gap-2 rounded-full bg-brand-600 hover:bg-brand-700 text-white font-bold shadow-lg shadow-brand-600/25">Shop all products <${Icon} d=${PATHS.search} cls="w-5 h-5" /></a>
                  <a href="#about" className="h-12 px-6 inline-flex items-center rounded-full border-2 border-zinc-300 dark:border-zinc-700 font-bold hover:border-brand-500 hover:text-brand-700 dark:hover:text-brand-300">About the store</a>
                </div>
                <dl className="mt-9 grid grid-cols-3 max-w-md divide-x divide-zinc-200 dark:divide-zinc-800">
                  ${[[PRODUCTS.length, 'Products'], [ALL_CATS.length, 'Categories'], [ALL_BRANDS.length, 'Brands']].map(([v, l], i) => html`
                    <div key=${l} className=${(i ? 'pl-5 ' : '') + ''}>
                      <dt className="sr-only">${l}</dt>
                      <dd className="font-display font-extrabold text-2xl sm:text-3xl">${v}</dd>
                      <dd className="text-xs font-bold uppercase tracking-wider text-zinc-500">${l}</dd>
                    </div>`)}
                </dl>
              </div>
              <div className="grid grid-cols-3 gap-3 sm:gap-4 fadein">
                ${heroImgs.map(p => html`
                  <figure key=${p.id} className="bg-white dark:bg-zinc-900 rounded-3xl border border-zinc-200 dark:border-zinc-800 p-3 shadow-sm">
                    <img src=${p.img} alt=${p.name} className="w-full aspect-square object-contain" />
                    <figcaption className="mt-2 flex items-start justify-between gap-2">
                      <span className="text-[11px] sm:text-xs font-bold leading-tight line-clamp-2">${p.name}</span>
                      <span className="text-[11px] sm:text-xs font-extrabold text-brand-700 dark:text-brand-300 whitespace-nowrap">${fmt(p.price)}</span>
                    </figcaption>
                  </figure>`)}
              </div>
            </div>
          </section>

          <!-- ===== ABOUT ===== -->
          <section id="about" className="max-w-7xl mx-auto px-4 sm:px-6 py-14 w-full">
            <div className="grid lg:grid-cols-2 gap-10 items-start">
              <div>
                <h2 className="font-display font-extrabold text-3xl sm:text-4xl">A proper general store, <span className="text-brand-600 dark:text-brand-400">now online.</span></h2>
                <p className="mt-4 text-zinc-600 dark:text-zinc-300 leading-relaxed">NandN International stocks the everyday essentials Pakistani homes run on — pantry staples, fresh dairy and bakery, drinks and snacks, and the full household range from laundry and cleaning to baby care and batteries. This page is our complete shelf: every one of the 293 lines we carry, with its picture, pack size and price.</p>
                <ul className="mt-6 space-y-4">
                  ${[['The whole shelf, listed', 'All 24 departments and 293 products in one searchable inventory — no item hidden, no price missing.'],
                     ['Prices printed up front', 'Every product shows its Rs price as listed on 8 Oct 2026, so you can plan your monthly shop before you visit.'],
                     ['Buy list in your pocket', 'Tap “Add to Buy” on anything, adjust quantities, and download your order list to bring to the counter.']].map(([t, d]) => html`
                    <li key=${t} className="flex gap-3">
                      <span className="mt-0.5 w-7 h-7 shrink-0 grid place-items-center rounded-full bg-brand-600 text-white"><${Icon} d=${PATHS.check} cls="w-4 h-4" /></span>
                      <span><b className="block">${t}</b><span className="text-sm text-zinc-500 dark:text-zinc-400">${d}</span></span>
                    </li>`)}
                </ul>
              </div>
              <div className="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-5 sm:p-6">
                <h3 className="font-display font-bold text-lg">Shop by department</h3>
                <p className="text-sm text-zinc-500 dark:text-zinc-400 mt-1">Tap a department to jump straight to its products.</p>
                <div className="mt-4 grid grid-cols-2 sm:grid-cols-3 gap-2">
                  ${ALL_CATS.map(c => html`
                    <button key=${c} onClick=${() => shopCategory(c)} className="text-left px-3 py-2.5 rounded-xl bg-brand-50 dark:bg-brand-950/60 hover:bg-brand-100 dark:hover:bg-brand-900 border border-transparent hover:border-brand-300 dark:hover:border-brand-700 transition">
                      <span className="block text-[13px] font-bold leading-tight">${c}</span>
                      <span className="block text-[11px] font-semibold text-brand-700 dark:text-brand-300 mt-0.5">${PRODUCTS.filter(p => p.cat === c).length} products</span>
                    </button>`)}
                </div>
              </div>
            </div>
          </section>

          <!-- ===== PRODUCTS / INVENTORY DASHBOARD ===== -->
          <section id="products" className="bg-white dark:bg-[#10160f] border-y border-zinc-200 dark:border-zinc-800">
            <div className="max-w-7xl mx-auto px-4 sm:px-6 py-14">
              <div className="flex flex-wrap items-end justify-between gap-4">
                <div>
                  <h2 className="font-display font-extrabold text-3xl sm:text-4xl">Products & Inventory</h2>
                  <p className="mt-2 text-zinc-500 dark:text-zinc-400 max-w-xl">Search, filter and sort the live catalogue. Switch to the table view to drag columns into your own order.</p>
                </div>
                <button onClick=${() => setShowInsights(!showInsights)} className="h-11 px-5 inline-flex items-center gap-2 rounded-full border-2 border-zinc-300 dark:border-zinc-700 font-bold text-sm hover:border-brand-500 hover:text-brand-700 dark:hover:text-brand-300">
                  <${Icon} d=${PATHS.chart} cls="w-5 h-5" /> ${showInsights ? 'Hide' : 'Show'} price insights
                </button>
              </div>

              <div className="mt-8 grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
                ${[['Matching products', filtered.length + ' of ' + PRODUCTS.length], ['Departments', ALL_CATS.length], ['Price range', fmt(MIN_PRICE) + ' – ' + fmt(MAX_PRICE)], ['Buy list total', fmt(cartTotal)]].map(([l, v]) => html`
                  <div key=${l} className="rounded-2xl bg-[#f6f7f4] dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 px-4 py-4">
                    <div className="text-[11px] font-extrabold uppercase tracking-[.12em] text-zinc-500">${l}</div>
                    <div className="font-display font-extrabold text-xl sm:text-2xl mt-1">${v}</div>
                  </div>`)}
              </div>

              <div className="mt-6 rounded-3xl border border-zinc-200 dark:border-zinc-800 bg-[#f6f7f4] dark:bg-zinc-900/60 p-4 sm:p-5">
                <div className="grid md:grid-cols-2 xl:grid-cols-[1fr_220px_220px_220px] gap-3">
                  <label className="relative block">
                    <span className="absolute left-3.5 top-1/2 -translate-y-1/2 text-zinc-400"><${Icon} d=${PATHS.search} cls="w-5 h-5" /></span>
                    <input value=${query} onInput=${e => setQuery(e.target.value)} type="search" placeholder="Search product, brand, pack or details…" aria-label="Search products"
                      className="w-full h-12 pl-11 pr-4 rounded-full bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700 font-semibold placeholder:font-medium placeholder:text-zinc-400 focus:outline-none focus:ring-2 focus:ring-brand-500" />
                  </label>
                  <select value=${cat} onChange=${e => setCat(e.target.value)} aria-label="Category" className="h-12 px-4 rounded-full bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700 font-semibold w-full">
                    <option value="">All categories (${PRODUCTS.length})</option>
                    ${ALL_CATS.map(c => html`<option key=${c} value=${c}>${c} (${PRODUCTS.filter(p => p.cat === c).length})</option>`)}
                  </select>
                  <select value=${brand} onChange=${e => setBrand(e.target.value)} aria-label="Brand" className="h-12 px-4 rounded-full bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700 font-semibold w-full">
                    <option value="">All brands</option>
                    ${ALL_BRANDS.map(b => html`<option key=${b} value=${b}>${b}</option>`)}
                  </select>
                  <select value=${sort} onChange=${e => setSort(e.target.value)} aria-label="Sort by" className="h-12 px-4 rounded-full bg-white dark:bg-zinc-900 border border-zinc-300 dark:border-zinc-700 font-semibold w-full">
                    <option value="featured">Sort: Catalogue order</option>
                    <option value="price-asc">Price: Low to High</option>
                    <option value="price-desc">Price: High to Low</option>
                    <option value="name-asc">Name: A to Z</option>
                    <option value="name-desc">Name: Z to A</option>
                    <option value="brand-asc">Brand: A to Z</option>
                    <option value="cat-asc">Category: A to Z</option>
                  </select>
                </div>
                <div className="mt-4 flex flex-wrap items-center gap-x-5 gap-y-3">
                  <label className="flex items-center gap-3 text-sm font-bold grow min-w-[220px]">
                    <span className="whitespace-nowrap">Max price</span>
                    <input type="range" min=${MIN_PRICE} max=${MAX_PRICE} step="5" value=${maxPrice} onInput=${e => setMaxPrice(Number(e.target.value))} className="grow" aria-label="Maximum price" />
                    <span className="whitespace-nowrap text-brand-700 dark:text-brand-300">${fmt(maxPrice)}</span>
                  </label>
                  <div className="flex items-center gap-2 ml-auto">
                    ${(query || cat || brand || maxPrice < MAX_PRICE) && html`<button onClick=${() => { setQuery(''); setCat(''); setBrand(''); setMaxPrice(MAX_PRICE); }} className="h-10 px-4 rounded-full text-sm font-bold text-brand-700 dark:text-brand-300 hover:bg-brand-50 dark:hover:bg-brand-950">Clear filters</button>`}
                    <div className="flex rounded-full border border-zinc-300 dark:border-zinc-700 overflow-hidden" role="group" aria-label="View">
                      <button onClick=${() => setView('grid')} className=${'h-10 px-4 inline-flex items-center gap-2 text-sm font-bold ' + (view === 'grid' ? 'bg-brand-600 text-white' : 'bg-white dark:bg-zinc-900')}><${Icon} d=${PATHS.grid} cls="w-4 h-4" /> Grid</button>
                      <button onClick=${() => setView('table')} className=${'h-10 px-4 inline-flex items-center gap-2 text-sm font-bold ' + (view === 'table' ? 'bg-brand-600 text-white' : 'bg-white dark:bg-zinc-900')}><${Icon} d=${PATHS.table} cls="w-4 h-4" /> Table</button>
                    </div>
                  </div>
                </div>
                <div className="mt-4 flex gap-2 overflow-x-auto no-scrollbar pb-1 -mx-1 px-1">
                  <button onClick=${() => setCat('')} className=${'shrink-0 h-9 px-4 rounded-full text-[13px] font-bold border ' + (!cat ? 'bg-brand-600 border-brand-600 text-white' : 'bg-white dark:bg-zinc-900 border-zinc-300 dark:border-zinc-700')}>All</button>
                  ${ALL_CATS.map(c => html`<button key=${c} onClick=${() => setCat(cat === c ? '' : c)} className=${'shrink-0 h-9 px-4 rounded-full text-[13px] font-bold border ' + (cat === c ? 'bg-brand-600 border-brand-600 text-white' : 'bg-white dark:bg-zinc-900 border-zinc-300 dark:border-zinc-700')}>${c}</button>`)}
                </div>
              </div>

              ${showInsights && html`
              <div className="mt-6 rounded-3xl border border-zinc-200 dark:border-zinc-800 p-5 sm:p-6 fadein">
                <h3 className="font-display font-bold text-lg">Average price by department</h3>
                <p className="text-sm text-zinc-500 dark:text-zinc-400">Mean listed price of the products in each department, dearest first.</p>
                <div className="mt-5 grid sm:grid-cols-2 xl:grid-cols-3 gap-x-10 gap-y-3">
                  ${catAvgs.map(({ cat: c, n, avg }) => html`
                    <button key=${c} onClick=${() => shopCategory(c)} className="text-left group">
                      <span className="flex justify-between gap-3 text-[13px] font-bold"><span className="truncate group-hover:text-brand-700 dark:group-hover:text-brand-300">${c}</span><span className="text-zinc-500 whitespace-nowrap">${n} items · ${fmt(avg)}</span></span>
                      <span className="mt-1 block h-2 rounded-full bg-zinc-200 dark:bg-zinc-800 overflow-hidden"><span className="block h-full rounded-full bg-brand-500 group-hover:bg-accent-500 transition-colors" style=${{ width: Math.max(4, Math.round(avg / maxAvg * 100)) + '%' }}></span></span>
                    </button>`)}
                </div>
              </div>`}

              <p className="mt-8 text-sm font-bold text-zinc-500 dark:text-zinc-400" role="status">Showing ${visible.length} of ${filtered.length} products${filtered.length !== PRODUCTS.length ? ' (filtered from ' + PRODUCTS.length + ')' : ''}</p>

              ${filtered.length === 0 && html`
                <div className="mt-6 rounded-3xl border border-dashed border-zinc-300 dark:border-zinc-700 p-10 text-center">
                  <p className="font-display font-bold text-xl">Nothing matches those filters</p>
                  <p className="text-sm text-zinc-500 mt-2">Try a different search word, or clear the filters to see the full shelf again.</p>
                  <button onClick=${() => { setQuery(''); setCat(''); setBrand(''); setMaxPrice(MAX_PRICE); }} className="mt-5 h-11 px-6 rounded-full bg-brand-600 hover:bg-brand-700 text-white font-bold text-sm">Clear all filters</button>
                </div>`}

              ${filtered.length > 0 && view === 'grid' && html`
              <div className="mt-4 grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-3 sm:gap-5">
                ${visible.map(p => html`
                <article key=${p.id} className="bg-[#fbfcfb] dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl overflow-hidden flex flex-col hover:shadow-lg hover:shadow-brand-600/5 hover:border-brand-300 dark:hover:border-brand-700 transition">
                  <div className="bg-white m-3 mb-0 rounded-2xl border border-zinc-100 dark:border-zinc-800">
                    <img src=${p.img} alt=${p.name} className="w-full aspect-square object-contain p-2" />
                  </div>
                  <div className="p-4 pt-3 flex flex-col grow">
                    <div className="flex items-center justify-between gap-2">
                      <span className="text-[10px] font-extrabold uppercase tracking-wider text-brand-700 dark:text-brand-300 bg-brand-50 dark:bg-brand-950 px-2 py-1 rounded-md truncate">${p.cat}</span>
                      <span className="text-[11px] font-bold text-zinc-400 whitespace-nowrap">#${p.id}</span>
                    </div>
                    <h3 className="mt-2 font-bold leading-snug line-clamp-2 min-h-[2.6em]">${p.name}</h3>
                    <p className="text-xs font-semibold text-zinc-500 dark:text-zinc-400 mt-0.5">${p.brand} · ${p.pack}</p>
                    <p className="text-xs text-zinc-500 dark:text-zinc-400 mt-1.5 line-clamp-2">${p.det}</p>
                    <div className="mt-auto pt-4 flex flex-wrap items-center justify-between gap-x-2 gap-y-2.5">
                      <span className="font-display font-extrabold text-lg sm:text-xl text-brand-700 dark:text-brand-300 whitespace-nowrap">${fmt(p.price)}</span>
                      ${cart[p.id]
                        ? html`<span className="inline-flex items-center gap-0.5 bg-brand-50 dark:bg-brand-950 border border-brand-200 dark:border-brand-800 rounded-full p-0.5">
                            <button onClick=${() => setQty(p.id, cart[p.id] - 1)} aria-label="Remove one ${p.name}" className="w-9 h-9 grid place-items-center rounded-full hover:bg-white dark:hover:bg-brand-900"><${Icon} d=${PATHS.minus} cls="w-4 h-4" /></button>
                            <b className="w-6 text-center text-sm">${cart[p.id]}</b>
                            <button onClick=${() => setQty(p.id, cart[p.id] + 1)} aria-label="Add one more ${p.name}" className="w-9 h-9 grid place-items-center rounded-full hover:bg-white dark:hover:bg-brand-900"><${Icon} d=${PATHS.plus} cls="w-4 h-4" /></button>
                          </span>`
                        : html`<button onClick=${() => addToCart(p)} className="h-10 px-4 inline-flex items-center gap-1.5 rounded-full bg-brand-600 hover:bg-brand-700 text-white text-[13px] font-bold whitespace-nowrap"><${Icon} d=${PATHS.cart} cls="w-4 h-4" /> Add to Buy</button>`}
                    </div>
                  </div>
                </article>`)}
              </div>`}

              ${filtered.length > 0 && view === 'table' && html`
              <div className="mt-4">
                <div className="rounded-3xl border border-zinc-200 dark:border-zinc-800 overflow-hidden md:overflow-x-auto bg-white dark:bg-zinc-900">
                  <table className="inv-table w-full text-left border-collapse">
                    <thead>
                      <tr>
                        ${cols.map((key, i) => { const col = COLUMNS.find(c => c.key === key); return html`
                        <th key=${key} draggable=${true}
                          onDragStart=${e => { setDragIdx(i); e.dataTransfer.effectAllowed = 'move'; try { e.dataTransfer.setData('text/plain', key); } catch (_) {} }}
                          onDragOver=${e => { e.preventDefault(); setOverIdx(i); }}
                          onDrop=${e => { e.preventDefault(); dropCol(i); }}
                          onDragEnd=${() => { setDragIdx(null); setOverIdx(null); }}
                          className=${'px-3 py-3 bg-brand-700 text-white text-[11px] font-extrabold uppercase tracking-wider cursor-grab active:cursor-grabbing select-none whitespace-nowrap ' + (overIdx === i && dragIdx !== null && dragIdx !== i ? 'drag-over' : '')}>
                          <span className="inline-flex items-center gap-1.5">
                            <${Icon} d=${PATHS.grip} cls="w-4 h-4 opacity-60" />
                            ${col.sortable
                              ? html`<button onClick=${() => headerSort(key)} className="uppercase tracking-wider font-extrabold hover:text-accent-400" title="Sort by ${col.label}">${col.label}${sort.startsWith(key) || (key === 'name' && sort.startsWith('name')) ? (sort.endsWith('desc') ? ' ↓' : ' ↑') : ''}</button>`
                              : html`<span>${col.label}</span>`}
                            <span className="inline-flex">
                              <button onClick=${() => moveCol(i, -1)} aria-label="Move ${col.label} column left" className="w-6 h-6 grid place-items-center rounded hover:bg-white/20 font-black">‹</button>
                              <button onClick=${() => moveCol(i, 1)} aria-label="Move ${col.label} column right" className="w-6 h-6 grid place-items-center rounded hover:bg-white/20 font-black">›</button>
                            </span>
                          </span>
                        </th>`; })}
                      </tr>
                    </thead>
                    <tbody>
                      ${visible.map(p => html`<tr key=${p.id} className="border-t border-zinc-100 dark:border-zinc-800 hover:bg-brand-50/60 dark:hover:bg-brand-950/40">${cols.map(key => cellFor(p, key))}</tr>`)}
                    </tbody>
                  </table>
                </div>
                <p className="mt-3 text-xs font-semibold text-zinc-500 dark:text-zinc-400">Tip: drag any column header to reorder the table — or use the ‹ › buttons on a header. Click a column name to sort by it.</p>
              </div>`}

              ${limit < filtered.length && html`
              <div className="mt-8 flex flex-wrap justify-center gap-3">
                <button onClick=${() => setLimit(limit + 48)} className="h-12 px-7 rounded-full bg-brand-600 hover:bg-brand-700 text-white font-bold">Show more products</button>
                <button onClick=${() => setLimit(filtered.length)} className="h-12 px-7 rounded-full border-2 border-zinc-300 dark:border-zinc-700 font-bold">Show all ${filtered.length}</button>
              </div>`}
            </div>
          </section>

          <!-- ===== CONTACT ===== -->
          <section id="contact" className="max-w-7xl mx-auto px-4 sm:px-6 py-14 w-full">
            <h2 className="font-display font-extrabold text-3xl sm:text-4xl">Contact the store</h2>
            <p className="mt-2 text-zinc-500 dark:text-zinc-400 max-w-xl">Questions about a product, a pack size, or a bulk order? Send us a message, or build a buy list and bring it in.</p>
            <div className="mt-8 grid lg:grid-cols-5 gap-6 items-start">
              <div className="lg:col-span-2 space-y-4">
                ${[['Visit the store', 'Walk in for daily essentials, fresh dairy and bakery, and the full household range — every department in the catalogue above is stocked on our shelves.'],
                   ['Order ahead', 'Add products to your buy list, download the order list, and share it with the store — we will keep your items ready at the counter.'],
                   ['Store hours', 'Open seven days a week, morning to late evening, so the monthly shop and the midnight emergency run are both covered.']].map(([t, d]) => html`
                  <div key=${t} className="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-5">
                    <h3 className="font-display font-bold">${t}</h3>
                    <p className="text-sm text-zinc-500 dark:text-zinc-400 mt-1.5 leading-relaxed">${d}</p>
                  </div>`)}
              </div>
              <form className="lg:col-span-3 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-3xl p-5 sm:p-7" onSubmit=${e => e.preventDefault()}>
                <h3 className="font-display font-bold text-lg">Write a message</h3>
                <div className="mt-4 grid sm:grid-cols-2 gap-3">
                  <label className="block">
                    <span className="text-xs font-extrabold uppercase tracking-wider text-zinc-500">Your name</span>
                    <input id="cname" type="text" placeholder="e.g. Ahmed Khan" className="mt-1.5 w-full h-12 px-4 rounded-2xl bg-[#f6f7f4] dark:bg-zinc-800 border border-zinc-300 dark:border-zinc-700 font-semibold focus:outline-none focus:ring-2 focus:ring-brand-500" />
                  </label>
                  <label className="block">
                    <span className="text-xs font-extrabold uppercase tracking-wider text-zinc-500">Phone (optional)</span>
                    <input id="cphone" type="tel" placeholder="03xx xxxxxxx" className="mt-1.5 w-full h-12 px-4 rounded-2xl bg-[#f6f7f4] dark:bg-zinc-800 border border-zinc-300 dark:border-zinc-700 font-semibold focus:outline-none focus:ring-2 focus:ring-brand-500" />
                  </label>
                </div>
                <label className="block mt-3">
                  <span className="text-xs font-extrabold uppercase tracking-wider text-zinc-500">Message</span>
                  <textarea id="cmsg" rows="4" placeholder="Ask about a product, a price, or a bulk order…" className="mt-1.5 w-full px-4 py-3 rounded-2xl bg-[#f6f7f4] dark:bg-zinc-800 border border-zinc-300 dark:border-zinc-700 font-semibold focus:outline-none focus:ring-2 focus:ring-brand-500"></textarea>
                </label>
                <div className="mt-5 flex flex-wrap gap-3">
                  <button type="button" onClick=${() => {
                    const name = document.getElementById('cname').value.trim();
                    const phone = document.getElementById('cphone').value.trim();
                    const msg = document.getElementById('cmsg').value.trim();
                    if (!msg) { say('Write a message first'); return; }
                    const text = 'Message for NandN International\nName: ' + (name || '—') + (phone ? '\nPhone: ' + phone : '') + '\n\n' + msg;
                    if (navigator.clipboard && navigator.clipboard.writeText) { navigator.clipboard.writeText(text).then(() => say('Message copied — paste it into WhatsApp or email')); }
                    else { say('Copy not available in this browser'); }
                  }} className="h-12 px-6 rounded-full bg-brand-600 hover:bg-brand-700 text-white font-bold text-sm">Copy message</button>
                  <button type="button" onClick=${() => {
                    const msg = document.getElementById('cmsg').value.trim();
                    const name = document.getElementById('cname').value.trim();
                    const a = document.createElement('a');
                    a.href = 'mailto:?subject=' + encodeURIComponent('Message for NandN International') + '&body=' + encodeURIComponent((name ? 'From: ' + name + '\n\n' : '') + msg);
                    document.body.appendChild(a); a.click(); a.remove();
                  }} className="h-12 px-6 rounded-full border-2 border-zinc-300 dark:border-zinc-700 font-bold text-sm">Open in email app</button>
                </div>
                <p className="mt-3 text-xs text-zinc-500 dark:text-zinc-400">Copying keeps everything on your device — paste the message into WhatsApp or any email to reach the store.</p>
              </form>
            </div>
          </section>

          <!-- ===== Footer ===== -->
          <footer className="mt-auto bg-brand-950 text-brand-100">
            <div className="max-w-7xl mx-auto px-4 sm:px-6 py-10 grid sm:grid-cols-3 gap-8">
              <div>
                <div className="flex items-center gap-3">
                  <span className="h-10 min-w-[46px] px-1.5 rounded-xl bg-white text-brand-800 grid place-items-center font-display font-extrabold text-[11px]">N&N</span>
                  <span className="font-display font-bold text-lg text-white">NandN International</span>
                </div>
                <p className="text-sm text-brand-200/80 mt-3 leading-relaxed">Your neighbourhood general store — 293 everyday products across 24 departments, with pictures and prices.</p>
              </div>
              <nav className="text-sm font-semibold space-y-2.5">
                <span className="block text-[11px] font-extrabold uppercase tracking-[.14em] text-brand-300">Explore</span>
                ${[['#home', 'Home'], ['#about', 'About'], ['#products', 'Products'], ['#contact', 'Contact']].map(([href, label]) => html`<a key=${href} href=${href} className="block hover:text-white py-0.5">${label}</a>`)}
              </nav>
              <div className="text-sm text-brand-200/80 leading-relaxed">
                <span className="block text-[11px] font-extrabold uppercase tracking-[.14em] text-brand-300 mb-2.5">Good to know</span>
                Prices are in Pakistani Rupees (Rs) as listed by online retailers on 8 Oct 2026; prices may vary by city and shop. Pack sizes and product details are shown on every item in the catalogue.
              </div>
            </div>
            <div className="border-t border-white/10">
              <div className="max-w-7xl mx-auto px-4 sm:px-6 py-4 text-xs text-brand-200/60 flex flex-wrap gap-2 justify-between">
                <span>© ${new Date().getFullYear()} NandN International. All rights reserved.</span>
                <span>General Store · Pakistan</span>
              </div>
            </div>
          </footer>

          <!-- ===== Cart drawer ===== -->
          ${cartOpen && html`
          <div className="fixed inset-0 z-50">
            <div className="absolute inset-0 bg-black/55" onClick=${() => setCartOpen(false)}></div>
            <aside className="drawer absolute right-0 top-0 h-full w-full max-w-md bg-white dark:bg-zinc-900 shadow-2xl flex flex-col" role="dialog" aria-label="Buy list">
              <div className="flex items-center gap-3 px-5 h-[68px] border-b border-zinc-200 dark:border-zinc-800">
                <${Icon} d=${PATHS.cart} cls="w-6 h-6 text-brand-600 dark:text-brand-400" />
                <h3 className="font-display font-bold text-lg grow">Your Buy List ${cartCount > 0 ? '(' + cartCount + ')' : ''}</h3>
                <button onClick=${() => setCartOpen(false)} aria-label="Close buy list" className="w-11 h-11 grid place-items-center rounded-full hover:bg-zinc-100 dark:hover:bg-zinc-800"><${Icon} d=${PATHS.x} cls="w-5 h-5" /></button>
              </div>
              ${placed ? html`
              <div className="grow grid place-items-center p-8 text-center">
                <div>
                  <span className="mx-auto w-16 h-16 grid place-items-center rounded-full bg-brand-600 text-white"><${Icon} d=${PATHS.check} cls="w-8 h-8" /></span>
                  <p className="font-display font-bold text-xl mt-4">Order list downloaded</p>
                  <p className="text-sm text-zinc-500 dark:text-zinc-400 mt-2 leading-relaxed">Your list of ${cartCount} item${cartCount === 1 ? '' : 's'} totalling ${fmt(cartTotal)} has been saved as a file. Show it at the counter or share it with the store to complete your purchase.</p>
                  <button onClick=${() => { setCart({}); setPlaced(false); setCartOpen(false); }} className="mt-6 h-12 px-7 rounded-full bg-brand-600 hover:bg-brand-700 text-white font-bold text-sm">Done — start a new list</button>
                </div>
              </div>` : cartIds.length === 0 ? html`
              <div className="grow grid place-items-center p-8 text-center">
                <div>
                  <p className="font-display font-bold text-xl">Your buy list is empty</p>
                  <p className="text-sm text-zinc-500 mt-2">Add products from the catalogue and they will appear here with quantities and a running total.</p>
                  <button onClick=${() => { setCartOpen(false); document.getElementById('products').scrollIntoView({ behavior: 'smooth' }); }} className="mt-6 h-12 px-7 rounded-full bg-brand-600 hover:bg-brand-700 text-white font-bold text-sm">Browse products</button>
                </div>
              </div>` : html`
              <div className="grow overflow-y-auto px-5 py-4 space-y-3">
                ${cartIds.map(id => { const p = PRODUCTS[id - 1]; return html`
                <div key=${id} className="flex gap-3 items-center border border-zinc-200 dark:border-zinc-800 rounded-2xl p-3">
                  <img src=${p.img} alt=${p.name} className="w-14 h-14 object-contain rounded-lg bg-white border border-zinc-100 dark:border-zinc-800 shrink-0" />
                  <div className="grow min-w-0">
                    <p className="font-bold text-sm leading-tight truncate">${p.name}</p>
                    <p className="text-xs text-zinc-500">${p.pack} · ${fmt(p.price)} each</p>
                    <div className="mt-1.5 inline-flex items-center gap-0.5 bg-brand-50 dark:bg-brand-950 border border-brand-200 dark:border-brand-800 rounded-full p-0.5">
                      <button onClick=${() => setQty(id, cart[id] - 1)} aria-label="Remove one" className="w-8 h-8 grid place-items-center rounded-full hover:bg-white dark:hover:bg-brand-900"><${Icon} d=${PATHS.minus} cls="w-4 h-4" /></button>
                      <b className="w-6 text-center text-sm">${cart[id]}</b>
                      <button onClick=${() => setQty(id, cart[id] + 1)} aria-label="Add one" className="w-8 h-8 grid place-items-center rounded-full hover:bg-white dark:hover:bg-brand-900"><${Icon} d=${PATHS.plus} cls="w-4 h-4" /></button>
                    </div>
                  </div>
                  <div className="text-right shrink-0">
                    <p className="font-display font-extrabold">${fmt(p.price * cart[id])}</p>
                    <button onClick=${() => setQty(id, 0)} aria-label="Remove ${p.name} from list" className="mt-1 w-9 h-9 grid place-items-center rounded-full text-zinc-400 hover:text-red-500 hover:bg-red-50 dark:hover:bg-red-950 ml-auto"><${Icon} d=${PATHS.trash} cls="w-5 h-5" /></button>
                  </div>
                </div>`; })}
              </div>
              <div className="border-t border-zinc-200 dark:border-zinc-800 px-5 py-4">
                <div className="flex justify-between items-baseline">
                  <span className="font-bold text-zinc-500">Total (${cartCount} item${cartCount === 1 ? '' : 's'})</span>
                  <span className="font-display font-extrabold text-2xl text-brand-700 dark:text-brand-300">${fmt(cartTotal)}</span>
                </div>
                <button onClick=${downloadOrder} className="mt-4 w-full h-12 inline-flex items-center justify-center gap-2 rounded-full bg-brand-600 hover:bg-brand-700 text-white font-bold"><${Icon} d=${PATHS.download} cls="w-5 h-5" /> Download order list</button>
                <button onClick=${() => setCart({})} className="mt-2 w-full h-10 rounded-full font-bold text-sm text-zinc-500 hover:text-red-500">Clear list</button>
              </div>`}
            </aside>
          </div>`}

          ${toast && html`<div className="toast fixed bottom-5 left-1/2 -translate-x-1/2 z-[60] max-w-[92vw] bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 pl-3 pr-5 py-3 rounded-full shadow-2xl flex items-center gap-2.5 font-bold text-sm"><span className="w-6 h-6 grid place-items-center rounded-full bg-brand-500 text-white shrink-0"><${Icon} d=${PATHS.check} cls="w-3.5 h-3.5" /></span><span className="truncate">${toast}</span></div>`}
        </div>`;
      }

      ReactDOM.createRoot(document.getElementById('root')).render(html`<${App} />`);
    </script>
  </body>
</html>
